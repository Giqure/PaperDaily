# PaperDaily server configuration.
# Copy this file to `.env` and adjust. Values already set in the real
# environment take precedence over this file.

# Port the API listens on.
PORT=3000

# Set to "production" to enable secure cookies and trust-proxy.
NODE_ENV=development

# Origin of the SPA, used for credentialed CORS.
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign session cookies. Generate a strong random value for prod,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
SESSION_SECRET=dev-insecure-secret-change-me

# Path to the SQLite database file. Defaults to server/data/paperdaily.sqlite.
# Relative paths resolve against the process working directory, so prefer an
# absolute path if you override this.
# DB_PATH=/var/lib/paperdaily/paperdaily.sqlite

# --- Daily reporter ---------------------------------------------------------
# The reporter collects arXiv papers for every subscribed scope, curates the
# top picks, and stores them as the day's digest (served at /api/papers/daily).
# Run it manually any time with: npm --workspace server run reporter

# Arm the in-process daily scheduler. Off by default; the manual CLI ignores it.
REPORTER_ENABLED=false
# Daily run time, Asia/Shanghai (UTC+8), "HH:MM".
REPORTER_DAILY_TIME=06:32

# OpenAI-compatible curation endpoint. Without a key the reporter still runs but
# falls back to keyword tags (no AI summaries).
# OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# OPENAI_MAX_TOKENS=8000
# OPENAI_RETRIES=3
# Max curation requests in flight at once (scopes are curated concurrently).
# arXiv fetching stays serial regardless of this value.
# OPENAI_CONCURRENCY=4

# Selection knobs (per scope, applied to every collected scope).
# REPORTER_TOP_N=10              # papers curated per scope
# REPORTER_PUSH_N=2              # top items per scope included in pushes
# REPORTER_MAX_CANDIDATES=30     # arXiv results pulled per query
# REPORTER_SAME_DAY_ONLY=true    # keep only the newest submission batch
# REPORTER_LOOKBACK_DAYS=3       # window when same-day-only is off
# REPORTER_DEDUP_DAYS=7          # skip papers stored within this many days

# arXiv politeness (export.arxiv.org).
# ARXIV_QUERY_DELAY_SECONDS=5    # pause between a scope's queries
# ARXIV_MIN_INTERVAL_SECONDS=5   # floor between any two requests
# ARXIV_RETRIES=5
# ARXIV_RETRY_DELAY_SECONDS=30
# ARXIV_USER_AGENT=paperdaily-reporter/0.1 (+contact)

# Optional: also dump each generated day to <dir>/YYYY-MM-DD.json for debugging.
# REPORTER_ARCHIVE_DIR=./reporter-archive

# --- Reporter push (per-user) -----------------------------------------------
# After each run, every user who enabled push in the app receives a digest of
# THEIR subscribed scopes. Users choose their channels (email to their account
# address, Bark to their own device key) in Settings — the values below are only
# the shared transport the server uses to deliver. Leave the transport for a
# channel unset to disable that channel for everyone.
# How many items per scope are pushed comes from REPORTER_PUSH_N above.

# Push layout: "summary" (one combined digest), "per_scope" (one push per
# scope), or "per_item" (one push per pushed paper). Applies to Bark.
# REPORTER_PUSH_MODE=summary

# Bark (iOS push, https://bark.day.app). Shared server URL only; each user
# supplies their own device key in Settings.
# BARK_SERVER=https://api.day.app
# BARK_BODY_LIMIT=3200           # per-push byte cap (clamped 800..3800)

# Email transport (SMTP). The sending mailbox/login is operator-level; each user
# receives at their own account email. All of EMAIL_FROM/SMTP_HOST/SMTP_PASSWORD
# are required for email push to work; SMTP_USER defaults to EMAIL_FROM if unset.
# EMAIL_FROM=bot@example.com
# EMAIL_SUBJECT_PREFIX=论文日报
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=                     # optional — only if the SMTP login differs from EMAIL_FROM
# SMTP_PASSWORD=app-specific-password
# SMTP_USE_SSL=true              # true for port 465; false for STARTTLS (587)
